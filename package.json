{
  "name": "post-message-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format",
    "workbench": "tsx scripts/workbench.ts",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "prepare": "husky"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-rxjs": "2.0.8",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react-swc": "4.0.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "glob": "11.0.3",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "tsx": "4.20.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.1",
    "vite": "7.1.2"
  }
}
